# Backend Environment Variables

# API Configuration
SECRET_KEY=your-secret-key-here
API_V1_STR=/api/v1
PROJECT_NAME=AI-Powered Notes Summarizer

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=notes_summarizer

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# Hugging Face Configuration (replaces Google Gemini)
# Get your Hugging Face API key from: https://huggingface.co/settings/tokens
HF_API_KEY=your-hugging-face-api-key

# Hugging Face Model Name
# Default: facebook/bart-large-cnn (Recommended for summarization)
# Other options: 
#   - facebook/bart-base (smaller, faster)
#   - google/pegasus-cnn_dailymail (another summarization model)
#   - meta-llama/Llama-2-7b (for general text generation, requires HF token)
HF_MODEL_NAME=facebook/bart-large-cnn

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Security Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
